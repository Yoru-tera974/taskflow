# ============================================================
# .env.prod — Configuration environnement PRODUCTION
# TaskFlow — TP Fil Rouge CI/CD
# ATTENTION : Ne jamais commiter les vraies valeurs !
# En production, injecter via Jenkins Credentials ou vault.
# ============================================================

NODE_ENV=production
PORT=80

# Base de données production (valeurs injectees par CI/CD)
DB_HOST=${DB_HOST_PROD}
DB_PORT=5432
DB_NAME=taskflow_prod
DB_USER=${DB_USER_PROD}
DB_PASSWORD=${DB_PASSWORD_PROD}

# JWT (secret genere et injecte par Jenkins)
JWT_SECRET=${JWT_SECRET_PROD}
JWT_EXPIRES=8h

# Logs
LOG_LEVEL=warn

# Docker
DOCKER_IMAGE=taskflow
DOCKER_PORT=8080
