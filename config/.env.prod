# ================================
# ENVIRONNEMENT : PRODUCTION
# ================================
NODE_ENV=production
PORT=8080

# Base de donnees (variables injectees depuis gestionnaire de secrets)
DB_HOST=${DB_HOST_PROD}
DB_PORT=5432
DB_NAME=taskflow_prod
DB_USER=${DB_USER_PROD}
DB_PASSWORD=${DB_PASSWORD_PROD}

# Application
APP_URL=https://taskflow.company.com
LOG_LEVEL=warn
DEBUG=false

# Secrets (JAMAIS en clair - injectes par le systeme de secrets)
JWT_SECRET=${JWT_SECRET_PROD}
SESSION_SECRET=${SESSION_SECRET_PROD}
