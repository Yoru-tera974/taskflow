# ================================
# ENVIRONNEMENT : TEST / STAGING
# ================================
NODE_ENV=test
PORT=8080

# Base de donnees
DB_HOST=db-test
DB_PORT=5432
DB_NAME=taskflow_test
DB_USER=test_user
DB_PASSWORD=${DB_PASSWORD_TEST}

# Application
APP_URL=http://staging.taskflow.internal
LOG_LEVEL=info
DEBUG=false

# Secrets (injectes par Jenkins / variables d'environnement CI)
JWT_SECRET=${JWT_SECRET_TEST}
SESSION_SECRET=${SESSION_SECRET_TEST}
